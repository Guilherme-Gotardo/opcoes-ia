# Postgres gerenciado (Neon) — FONTE DA VERDADE da carteira.
# É o que Lambda/Fargate usam e o que você opera no dia a dia.
# `sslmode=require` é obrigatório e explícito: o psycopg usa `prefer` por
# padrão, que aceita conexão sem TLS. Contra o Neon isso funciona por
# acidente, e o dia em que não funcionar o erro será obscuro.
# Runtime serverless usa o hostname com `-pooler`; migracao recebe uma URL
# direta separada por `NEON_DIRECT_DATABASE_URL` no GitHub Environment, nunca
# por este arquivo versionado.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Postgres local (docker compose up -d db) — banco DESCARTÁVEL.
# Serve para teste de integração e experimentação; pode ser derrubado e
# recriado sem perda. Não guarda carteira real. Para rodar a suíte contra
# ele sem mexer no .env:
#   DATABASE_URL=postgresql://opcoes_ia:opcoes_ia@localhost:5433/opcoes_ia pytest
# DATABASE_URL=postgresql://opcoes_ia:opcoes_ia@localhost:5433/opcoes_ia

# Opcional: somente para a implementação legada de fetch_options.py.
# O provedor de opções atual está bloqueado/abandonado no plano em uso.
# OPLAB_TOKEN=coloque_seu_token_aqui
BRAPI_TOKEN=coloque_seu_token_aqui
# BRAPI_REQUESTS_DIA_MAXIMO=600
# NEWS_API_KEY=coloque_sua_chave_aqui

# API. Ausente ou diferente de `prod` mantém o modo local sem autenticação;
# produção falha ao iniciar se origem, issuer, client ou escopo estiverem ausentes.
# OPCOES_IA_ENV=prod
# OPCOES_IA_WEB_ORIGIN=https://dxxxxxxxxxxxxx.cloudfront.net
# COGNITO_ISSUER=https://cognito-idp.sa-east-1.amazonaws.com/sa-east-1_EXEMPLO
# COGNITO_CLIENT_ID=client-publico-sem-secret
# COGNITO_REQUIRED_SCOPE=opcoes-ia/api

# Opcional: somente a etapa do agente, quando houver insumo.
# ANTHROPIC_API_KEY=sk-ant-...

# Opcional: entrega determinística do relatório e alertas do pregão.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASSWORD=senha
# SMTP_FROM=opcoes-ia@exemplo.com
# SMTP_TO=voce@exemplo.com
# SMTP_STARTTLS=1
