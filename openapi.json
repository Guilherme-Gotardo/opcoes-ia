            "title": "Cotacao Em"
          },
          "motivo_sem_cotacao": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Motivo Sem Cotacao"
          },
          "valor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valor"
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "tipo_ativo",
          "quantidade",
          "preco_medio",
          "preco_mercado",
          "cotacao_em",
          "motivo_sem_cotacao",
          "valor"
        ],
        "title": "PosicaoResposta"
      },
      "SugestaoResposta": {
        "properties": {
