          },
          "quantidade": {
            "type": "integer",
            "title": "Quantidade"
          },
          "preco_medio": {
            "type": "number",
            "title": "Preco Medio",
            "description": "Base de custo — nunca usada como valor"
          },
          "preco_mercado": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
