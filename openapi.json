            "type": "string",
            "title": "Ticker Objeto"
          },
          "tipo_operacao": {
            "type": "string",
            "title": "Tipo Operacao"
          },
          "codigo_opcao": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Codigo Opcao"
          },
          "strike": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
